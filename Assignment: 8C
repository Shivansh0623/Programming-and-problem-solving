#include <stdio.h>
void swap(float *a, float *b)
{
float temp;
temp = *a;
*a = *b;
*b = temp;
}
int main(){
float temp1, temp2;

printf("Enter the temperature of Incubator 1: ");
scanf("%f", &temp1);

printf("Enter the temperature of Incubator 2: ");
scanf("%f", &temp2);

printf("\n Before Swapping: \n");
printf("Incubator 1 Temperature = %.2f C\n", temp1);
printf("Incubator 2 Temperature = %.2f C\n", temp2);

swap (&temp1, &temp2);

printf("\nAfter swapping: \n");
printf("Incubator 1 Temperature = %.2f C\n", temp1);
printf("Incubator 2 Temperature = %.2f C\n", temp2);
return 0;
}
